{
  "name": "codex-resource-governor",
  "version": "0.2.0",
  "description": "Local quota-aware task management and per-turn model selection for Codex",
  "type": "module",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/shuwei1006/codex-resource-governor.git"},
  "homepage": "https://github.com/shuwei1006/codex-resource-governor#readme",
  "bugs": {"url": "https://github.com/shuwei1006/codex-resource-governor/issues"},
  "engines": { "node": ">=20" },
  "bin": { "codex-governor": "dist/cli.js" },
  "files": ["dist", "README.md", "README.zh-CN.md", "LICENSE", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md", "docs"],
  "keywords": ["codex", "cli", "tui", "quota", "governor"],
  "scripts": {
    "dev": "node --import tsx src/cli.tsx",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.0",
    "eslint": "^9.39.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
